{
  "name": "ccrecord",
  "title": "CCRecord Inspector",
  "version": "0.2.2",
  "package_version": 2,
  "description": "Serializable typed Record Inspector with mounted AssetDB runtime and optional test importer (preview)",
  "author": "PhuNope",
  "editor": ">=3.8.2",
  "main": "./dist/main.js",
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension/CCRecord",
        "label": "Import / Update Test Files...",
        "message": "open-panel"
      },
      {
        "path": "i18n:menu.extension/CCRecord",
        "label": "Reload Inspector",
        "message": "reload-inspector"
      },
      {
        "path": "i18n:menu.extension/CCRecord",
        "label": "Inspector Diagnostics",
        "message": "diagnostics"
      },
      {
        "path": "i18n:menu.extension/CCRecord",
        "label": "Enable Inspector Hook",
        "message": "enable-inspector"
      },
      {
        "path": "i18n:menu.extension/CCRecord",
        "label": "Disable Inspector Hook",
        "message": "disable-inspector"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "import-test-files": {
        "methods": [
          "importTestFiles"
        ]
      },
      "list-test-files": {
        "methods": [
          "listTestFiles"
        ]
      },
      "reload-inspector": {
        "methods": [
          "reloadInspector"
        ]
      },
      "diagnostics": {
        "methods": [
          "diagnostics"
        ]
      },
      "enable-inspector": {
        "methods": [
          "enableInspector"
        ]
      },
      "disable-inspector": {
        "methods": [
          "disableInspector"
        ]
      }
    },
    "asset-db": {
      "mount": {
        "path": "./assets",
        "readonly": true
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/run-tests.js",
    "pack": "node scripts/build.js && python3 scripts/pack.py"
  },
  "license": "UNLICENSED",
  "panels": {
    "default": {
      "title": "CCRecord",
      "type": "dockable",
      "main": "./dist/panels/default",
      "size": {
        "min-width": 340,
        "min-height": 300,
        "width": 470,
        "height": 540
      }
    }
  }
}
